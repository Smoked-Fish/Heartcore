{
	"schemaVersion": 1,
	"id": "heartcore",
	"version": "${version}",
	"name": "Heartcore",
	"description": "Heartcore is a Hardcore Minecraft mod that grants players multiple lives with harsh punishments.",
	"authors": [
		"Espy"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/heartcore/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"espy.heartcore.Heartcore"
		],
		"fabric-datagen": [
			"espy.heartcore.HeartcoreDataGenerator"
		],
		"client": [
			"espy.heartcore.client.HeartcoreClient"
		],
		"modmenu": [
			"espy.heartcore.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"heartcore.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-command-api-v2": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}